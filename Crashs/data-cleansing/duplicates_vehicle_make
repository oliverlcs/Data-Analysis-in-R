install.packages("stringr")
library(dplyr)
library(stringr)

data <- read.csv("Crashs/data/Crash_Reporting_Drivers_Data.csv")

data <- data %>%
  mutate(vehicle_make_clean = Vehicle.Make %>%
    str_to_lower() %>%
    str_squish() #delete double spaces 
  )

data %>%
  count(vehicle_make_clean, sort = TRUE)

#install.packages("stringdist")
library(stringdist)

brands <- unique(data$vehicle_make_clean)
brands <- brands[brands != "" & !is.na(brands)]
dist_mat <- stringdistmatrix(brands, brands, method ="jw")
hc <- hclust(as.dist(dist_mat))
clusters <- cutree(hc, h = 0.15)
result <- data.frame(brand = brands, cluster = clusters) %>%
  arrange(cluster)
print(result)

library(dplyr)

clean_brands <- data %>%
  group_by(vehicle_make_clean) %>%
  summarise(n = n()) %>%
  left_join(result, by = c("vehicle_make_clean" = "brand")) %>%
  group_by(cluster) %>%
  slice_max(n, n=1, with_ties=F) %>%
  select(cluster, canonical = vehicle_make_clean)

data <- data %>%
  left_join(result, by = c("vehicle_make_clean" = "brand")) %>%
  left_join(clean_brands, by="cluster") %>%
  mutate(make_final = canonical)

data$make_final <- str_to_title(data$make_final)
unique(data$make_final)
table(data$make_final)

